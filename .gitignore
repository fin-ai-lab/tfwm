plots/market-129B-mi-measurement/
# Regenerable numpy caches written next to plot scripts: cached embedding
# panels, component dumps, anything a --refresh flag rebuilds. These run tens
# to hundreds of MB each and have already cost two history rewrites to get
# back out, so the rule is deliberately for ALL of plots/ rather than the one
# directory that happened to bite. Test fixtures under tests/ are unaffected.
plots/**/*.npz

# Driver/SLURM console logs written next to the plot pipelines by `tee`
# (run_eval.sh, run_latent.sh). Regenerated on the next run; ten of them had
# been committed, the largest a 26 KB console dump nothing reads.
#
# The `.log*` glob rather than `*.log`: the top-level `*.log` rule missed
# `view_learners_run.log.attempt1`, which a retry suffix put out of its reach,
# and it reached a checkpoint commit. Retry/rotation suffixes are the normal
# shape of these, so match the stem.
plots/**/*.out
plots/**/*.log
plots/**/*.log.*

# Symlinks named `cache` pointing into lab/ scratch. The existing
# `**/cache/` rule matches directories only, so a symlink of that name was
# tracked and dangled on every machine that is not this one.
plots/**/cache

# Per-plot wandb API response caches: regenerated on demand, never a result.
plots/**/api_cache.json

# Ad-hoc data bundles zipped up for review/transfer. 89 MB of one of these
# was sitting untracked and unignored next to a history of "add everything"
# checkpoint commits.
market-jepa-review-data.zip
*-review-data.zip

# Local scratch scripts that live beside the tracked pipelines. Kept out of
# the tree deliberately rather than by neglect: they are one-off rescue and
# placement helpers, and the repo's history of "add everything" checkpoints is
# exactly how an unfinished one ends up merged.
scripts/eval/place_probe_embeddings.py

# Market-1T data downloaded by machine=market1t (market_jepa/market1t.py)
/market1t/

# Data roots the local machine config reads (machine=local): usually symlinks
# to wherever the mosaic, checkpoints and Polygon snapshots live.
/lab
/polygon
