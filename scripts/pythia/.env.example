# pythia/.env — Machine-specific configuration for Pythia cluster scripts.
# Copy to .env and fill in your values. This file (.env) is gitignored.

# Your username on the Pythia cluster (login nodes)
PYTHIA_USER="your_pythia_username"

# Home directory on Pythia (NFS-mounted, may differ from PYTHIA_USER)
PYTHIA_HOME="/home/your_username"

# Your username on bll01 (the data source machine)
BLL01_USER="your_bll01_username"

# bll01 IP address (reachable from Pythia compute nodes)
BLL01_IP="x.x.x.x"

# Path to training data on bll01
BLL01_DATA_DIR="/path/to/market-jepa/data"

# Path to metadata on bll01
BLL01_METADATA="/path/to/metadata.parquet"
