# generic/.env.example — Template for per-cluster env files.
# Copy to .env.<variant> (e.g. .env.h100); the cluster variant is chosen at
# submit time (`./run_all_months_sweep.sh <variant> <sweep_file>`).
# The values below are an annotated example for an 8xH100 box.

# SSH alias for the cluster (defined in ~/.ssh/config)
CLUSTER_HOST="h100_cluster"
CLUSTER_USER="ubuntu"
CLUSTER_HOME="/home/ubuntu"

# All working dirs live under $HOME on the cluster.
CLUSTER_DATA="/home/ubuntu/market-jepa-data"
CLUSTER_CKPT="/home/ubuntu/market-jepa-checkpoints"
CLUSTER_UV_CACHE="/home/ubuntu/.cache/uv"

# Per-job sbatch resources. Budget: 8 concurrent jobs must fit the box —
# CPUs/8 rounded down for cpus-per-task, and SBATCH_MEM × 8 under the
# RealMemory you set in slurm.conf.
SBATCH_CPUS_PER_TASK=24
SBATCH_MEM=215G

# Hydra machine= selection. The machine config's num_workers must be sized
# to SBATCH_CPUS_PER_TASK (see schemas.py) — reserving CPUs the dataloader
# never uses starves the GPU while the cores idle.
MACHINE_NAME="h100_cluster"

# GiB of dense-grid cache PER dataloader worker (0 = off). Size
# num_workers × this + ~100G base RSS against SBATCH_MEM. Default-guarded
# so a submit-time override survives the compute node re-sourcing this file.
GRID_CACHE_GB="${GRID_CACHE_GB:-0}"

# Data host (data source). The cluster pulls month data on demand via
# `ssh datahost` / `rsync datahost:...`. cluster_setup() in lib/setup.sh
# authorizes the cluster's pubkey on the data host and writes a `Host datahost`
# entry into the cluster's ~/.ssh/config pointing at DATA_HOST_IP.
DATA_HOST_USER="your_username"
DATA_HOST_IP="your_data_host_ip"   # must be reachable from the cluster
# Short hostname of the data host; lets cluster_setup authorize the cluster's
# key when it is run there.
DATA_HOST_NAME="your_data_host_name"
DATA_HOST_DIR="lab/market-jepa-mosaic"
DATA_HOST_METADATA="polygon/snapshots/metadata.parquet"
